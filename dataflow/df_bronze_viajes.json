{
	"name": "df_bronze_viajes",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_viajes_csv",
						"type": "DatasetReference"
					},
					"name": "csv"
				},
				{
					"dataset": {
						"referenceName": "bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sql"
				},
				{
					"dataset": {
						"referenceName": "bronze_viajes_2022_xlsx",
						"type": "DatasetReference"
					},
					"name": "xlsx2022"
				},
				{
					"dataset": {
						"referenceName": "bronze_viajes_2023_xlsx",
						"type": "DatasetReference"
					},
					"name": "xlsx2023"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "select3"
				},
				{
					"name": "select2"
				},
				{
					"name": "csvsql"
				},
				{
					"name": "csvxlsx2022"
				},
				{
					"name": "csvxlsx2023"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_viaje as string,",
				"          cod_ruta as string,",
				"          nro_bus as string,",
				"          fec_servicio as string,",
				"          hora_programada as string,",
				"          hora_salida as string,",
				"          hora_llegada as string,",
				"          pasajeros_reportados as string,",
				"          km_recorridos as string,",
				"          estado_viaje as string,",
				"          tipo_metrica as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> csv",
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sql",
				"source(output(",
				"          id_viaje as string,",
				"          cod_ruta as string,",
				"          nro_bus as string,",
				"          fecha_servicio as string,",
				"          hora_programada as string,",
				"          hora_salida as string,",
				"          hora_llegada as string,",
				"          pasajeros_estimados as string,",
				"          km_recorridos as string,",
				"          estado_viaje as string,",
				"          tipo_metrica as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xlsx2022",
				"source(output(",
				"          id_viaje as string,",
				"          cod_ruta as string,",
				"          nro_bus as string,",
				"          fecha_servicio as string,",
				"          hora_programada as string,",
				"          hora_salida as string,",
				"          hora_llegada as string,",
				"          pasajeros_estimados as string,",
				"          km_recorridos as string,",
				"          estado_viaje as string,",
				"          tipo_metrica as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xlsx2023",
				"csv select(mapColumn(",
				"          ViajeId = id_viaje,",
				"          RutaHistoricaId = cod_ruta,",
				"          VehiculoId = nro_bus,",
				"          FechaServicio = fec_servicio,",
				"          HoraProgramada = hora_programada,",
				"          HoraSalida = hora_salida,",
				"          HoraLlegada = hora_llegada,",
				"          ValidacionesTarjeta = pasajeros_reportados,",
				"          KmRecorridos = km_recorridos,",
				"          EstadoViaje = estado_viaje,",
				"          AnioFuente = tipo_metrica",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"xlsx2023 select(mapColumn(",
				"          ViajeId = id_viaje,",
				"          RutaHistoricaId = cod_ruta,",
				"          VehiculoId = nro_bus,",
				"          FechaServicio = fecha_servicio,",
				"          HoraProgramada = hora_programada,",
				"          HoraSalida = hora_salida,",
				"          HoraLlegada = hora_llegada,",
				"          PasajerosEstimados = pasajeros_estimados,",
				"          KmRecorridos = km_recorridos,",
				"          EstadoViaje = estado_viaje,",
				"          AnioFuente = tipo_metrica",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"xlsx2022 select(mapColumn(",
				"          ViajeId = id_viaje,",
				"          RutaHistoricaId = cod_ruta,",
				"          VehiculoId = nro_bus,",
				"          FechaServicio = fecha_servicio,",
				"          HoraProgramada = hora_programada,",
				"          HoraSalida = hora_salida,",
				"          HoraLlegada = hora_llegada,",
				"          PasajerosEstimados = pasajeros_estimados,",
				"          KmRecorridos = km_recorridos,",
				"          EstadoViaje = estado_viaje,",
				"          AnioFuente = tipo_metrica",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select1, sql union(byName: true)~> csvsql",
				"csvsql, select2 union(byName: true)~> csvxlsx2022",
				"csvxlsx2022, select3 union(byName: true)~> csvxlsx2023",
				"csvxlsx2023 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          HoraProgramada,",
				"          HoraSalida,",
				"          HoraLlegada,",
				"          ValidacionesTarjeta,",
				"          KmRecorridos,",
				"          EstadoViaje",
				"     )) ~> sink1"
			]
		}
	}
}