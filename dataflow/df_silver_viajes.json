{
	"name": "df_silver_viajes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedclaves"
				},
				{
					"name": "derivedtextos"
				},
				{
					"name": "derivedtipos"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(ViajeId = iif(isNull(ViajeId) || ViajeId == 'NULL' || trim(ViajeId) == '', concat('VJ-', trim(RutaHistoricaId), '_', trim(VehiculoId)), upper(trim(ViajeId))),",
				"          RutaHistoricaId = upper(trim(RutaHistoricaId)),",
				"          VehiculoId = upper(trim(VehiculoId))) ~> derivedclaves",
				"derivedclaves derive(EstadoViaje = upper(trim(EstadoViaje))) ~> derivedtextos",
				"derivedtextos derive(FechaServicio = iif(instr(FechaServicio, '/') > 0, toDate(trim(FechaServicio), 'dd/MM/yyyy'), toDate(trim(FechaServicio), 'yyyy-MM-dd')),",
				"          HoraProgramada = iif(isNull(HoraProgramada) || trim(toString(HoraProgramada)) == '' || upper(trim(toString(HoraProgramada))) == 'NULL',     toTimestamp('1900-01-01 00:00:00', 'yyyy-MM-dd HH:mm:ss'),     toTimestamp(concat('1900-01-01 ', right(trim(toString(HoraProgramada)), 8)), 'yyyy-MM-dd HH:mm:ss') ),",
				"          HoraSalida = iif(isNull(HoraSalida) || trim(toString(HoraSalida)) == '' || upper(trim(toString(HoraSalida))) == 'NULL',     toTimestamp('1900-01-01 00:00:00', 'yyyy-MM-dd HH:mm:ss'),     toTimestamp(concat('1900-01-01 ', right(trim(toString(HoraSalida)), 8)), 'yyyy-MM-dd HH:mm:ss') ),",
				"          HoraLlegada = iif(isNull(HoraLlegada) || trim(toString(HoraLlegada)) == '' || upper(trim(toString(HoraLlegada))) == 'NULL',     toTimestamp('1900-01-01 00:00:00', 'yyyy-MM-dd HH:mm:ss'),     toTimestamp(concat('1900-01-01 ', right(trim(toString(HoraLlegada)), 8)), 'yyyy-MM-dd HH:mm:ss') ),",
				"          ValidacionesTarjeta = toInteger(trim(ValidacionesTarjeta)),",
				"          KmRecorridos = toDecimal(trim(KmRecorridos), 8, 1)) ~> derivedtipos",
				"derivedtipos aggregate(groupBy(ViajeId),",
				"     RutaHistoricaId = first(RutaHistoricaId),",
				"          VehiculoId = first(VehiculoId),",
				"          FechaServicio = first(FechaServicio),",
				"          HoraProgramada = first(HoraProgramada),",
				"          HoraSalida = first(HoraSalida),",
				"          HoraLlegada = first(HoraLlegada),",
				"          ValidacionesTarjeta = first(ValidacionesTarjeta),",
				"          KmRecorridos = first(KmRecorridos),",
				"          EstadoViaje = first(EstadoViaje)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          HoraProgramada,",
				"          HoraSalida,",
				"          HoraLlegada,",
				"          ValidacionesTarjeta,",
				"          KmRecorridos,",
				"          EstadoViaje",
				"     )) ~> sink1"
			]
		}
	}
}