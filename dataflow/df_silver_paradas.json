{
	"name": "df_silver_paradas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedclaves"
				},
				{
					"name": "derivedtextos"
				},
				{
					"name": "derivedtipos"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(ParadaHistoricaId = iif(isNull(ParadaHistoricaId) || ParadaHistoricaId == 'NULL', concat('PAR_', trim(CodigoPublicado)), trim(ParadaHistoricaId))) ~> derivedclaves",
				"derivedclaves derive(CodigoPublicado = upper(trim(CodigoPublicado)),",
				"          NombreParada = trim(NombreParada),",
				"          Zona = upper(trim(Zona)),",
				"          Estado = upper(trim(Estado))) ~> derivedtextos",
				"derivedtextos derive(Latitud = toDecimal(trim(Latitud), 9, 6),",
				"          Longitud = toDecimal(trim(Longitud), 9, 6),",
				"          VigenciaDesde = iif(isNull(VigenciaDesde) || trim(toString(VigenciaDesde)) == '' || upper(trim(toString(VigenciaDesde))) == 'NULL',     toDate('1900-01-01', 'yyyy-MM-dd'),     iif(instr(toString(VigenciaDesde), '/') > 0,         toDate(trim(toString(VigenciaDesde)), 'dd/MM/yyyy'),         toDate(trim(toString(VigenciaDesde)), 'yyyy-MM-dd')     ) ),",
				"          VigenciaHasta = iif(isNull(VigenciaHasta) || trim(toString(VigenciaHasta)) == '' || upper(trim(toString(VigenciaHasta))) == 'NULL',     toDate('2099-12-31', 'yyyy-MM-dd'),     iif(instr(toString(VigenciaHasta), '/') > 0,         toDate(trim(toString(VigenciaHasta)), 'dd/MM/yyyy'),         toDate(trim(toString(VigenciaHasta)), 'yyyy-MM-dd')     ) )) ~> derivedtipos",
				"derivedtipos aggregate(groupBy(ParadaHistoricaId),",
				"     CodigoPublicado = first(CodigoPublicado),",
				"          NombreParada = first(NombreParada),",
				"          Zona = first(Zona),",
				"          Latitud = first(Latitud),",
				"          Longitud = first(Longitud),",
				"          VigenciaDesde = first(VigenciaDesde),",
				"          VigenciaHasta = first(VigenciaHasta),",
				"          Estado = first(Estado)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as decimal(9,6),",
				"          Longitud as decimal(9,6),",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ParadaHistoricaId,",
				"          CodigoPublicado,",
				"          NombreParada,",
				"          Zona,",
				"          Latitud,",
				"          Longitud,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}