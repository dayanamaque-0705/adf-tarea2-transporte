{
	"name": "df_silver_rutas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedclaves"
				},
				{
					"name": "derivedtextos"
				},
				{
					"name": "derivedtipos"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(RutaHistoricaId = iif(isNull(RutaHistoricaId) || RutaHistoricaId == 'NULL' || trim(RutaHistoricaId) == '', concat('RH-', lpad(regexReplace(CodigoRuta, '[^0-9]', ''), 2, '0')), regexReplace(upper(trim(RutaHistoricaId)), '^RH-([0-9])$', 'RH-0$1'))) ~> derivedclaves",
				"derivedclaves derive(CodigoRuta = iif(regexMatch(trim(CodigoRuta), '^[0-9]+$'), concat('R-', lpad(trim(CodigoRuta), 2, '0')), iif(startsWith(upper(trim(CodigoRuta)), 'RUTA '), concat('R-', lpad(trim(regexReplace(upper(trim(CodigoRuta)), '^RUTA\\\\s*', '')), 2, '0')), upper(trim(CodigoRuta)))),",
				"          NombreRuta = trim(NombreRuta),",
				"          Destino = upper(trim(Destino)),",
				"          Origen = upper(trim(Origen)),",
				"          Estado = upper(trim(Estado))) ~> derivedtextos",
				"derivedtextos derive(VigenciaDesde = iif(instr(VigenciaDesde, '/') > 0, toDate(trim(VigenciaDesde), 'dd/MM/yyyy'), toDate(trim(VigenciaDesde), 'yyyy-MM-dd')),",
				"          VigenciaHasta = iif(instr(VigenciaHasta, '/') > 0, toDate(trim(VigenciaHasta), 'dd/MM/yyyy'), toDate(trim(VigenciaHasta), 'yyyy-MM-dd'))) ~> derivedtipos",
				"derivedtipos aggregate(groupBy(RutaHistoricaId),",
				"     NombreRuta = first(NombreRuta),",
				"          CodigoRuta = first(CodigoRuta),",
				"          Origen = first(Origen),",
				"          Destino = first(Destino),",
				"          VigenciaDesde = first(VigenciaDesde),",
				"          VigenciaHasta = first(VigenciaHasta),",
				"          Estado = first(Estado)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          RutaHistoricaId,",
				"          CodigoRuta,",
				"          NombreRuta,",
				"          Origen,",
				"          Destino,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}